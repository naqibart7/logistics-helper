# Runtime data — Naqib's personal answers live on the Oracle VM, never in git
data/daily/*
data/items/*
data/reports/*
!data/daily/.gitkeep
!data/items/.gitkeep
!data/reports/.gitkeep

# Windows-hardening runtime state (W2/W3b/W4) — per-machine scratch, not answers
data/.bot.lock
data/fired.json
data/heartbeat.json
backups/

# Secrets
.env

# Python
__pycache__/
*.pyc
.pytest_cache/

# Local run logs (may contain tokens in URLs - never commit)
logs_*.txt
logs/

