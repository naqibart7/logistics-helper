# Copy to `.env` and fill in real values. NEVER commit `.env`.
TELEGRAM_BOT_TOKEN=
NAQIB_CHAT_ID=
ADMIN_CHAT_ID=

# ── LLM (weekly compile) ──
# Groq (recommended, free). Model carried from Teleport (openai/gpt-oss-120b).
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Optional overrides:
# LLM_API_KEY=
# LLM_BASE_URL=
# MIN_DAYS_FOR_REPORT=3

# Proof-mode only (restart bot to fire the midday question immediately):
# V2_TEST_SEND=1